{
  "name": "vol-cfg-tool",
  "private": true,
  "version": "0.2.0",
  "description": "Lib_VolM 配置工具：填表 / 导入 vol_cfg.yaml → 生成 vol_cfg.h 与 vol_cfg.c",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "vitest run tests/e2e.test.ts"
  },
  "dependencies": {
    "js-yaml": "^5.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
